<div class="col project-card">
  <div class="card h-100 hoverable">
    {% if project.img %}
      <img class="card-img-top project-thumb" src="{{ project.img | relative_url }}" alt="" loading="lazy" />
    {% endif %}
    <div class="card-body">
      {% if project.status == "ongoing" %}<span class="project-status">Ongoing</span>{% endif %}
      <h2 class="card-title">
        <a class="stretched-link" href="{% if project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}">{{ project.title }}</a>
      </h2>
      <p class="card-text">{{ project.description }}</p>
      {% if project.github %}
        <a class="project-code" href="{{ project.github }}" title="Code repository" aria-label="Code for {{ project.title }} on GitHub"><i class="fa-brands fa-github gh-icon"></i></a>
      {% endif %}
    </div>
  </div>
</div>
