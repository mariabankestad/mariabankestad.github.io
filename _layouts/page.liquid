---
layout: default
---
<div class="post">
  <header class="post-header">
    <h1 class="post-title">{{ page.title }}</h1>
    <p class="post-description">{{ page.description }}</p>
    {% if page.github or page.website or page.walkthrough %}
      <div class="project-code-link">
        {% if page.github %}
          <a href="{{ page.github }}" target="_blank" rel="noopener noreferrer">
            <i class="fa-brands fa-github"></i> Code on GitHub
          </a>
        {% endif %}
        {% if page.website %}
          <a href="{{ page.website }}" target="_blank" rel="noopener noreferrer">
            <i class="fa-solid fa-arrow-up-right-from-square"></i> Project page
          </a>
        {% endif %}
        {% if page.walkthrough %}
          <a href="{{ page.walkthrough }}" target="_blank" rel="noopener noreferrer">
            <i class="fa-solid fa-book-open"></i> Walkthrough
          </a>
        {% endif %}
      </div>
    {% endif %}
  </header>

  <article>
    {{ content }}
  </article>

  {% if page.areas %}
    <div class="project-areas">
      <span class="pa-label">Part of</span>
      {% for a in page.areas %}
        {% assign areadef = site.data.research_areas | where: "slug", a | first %}
        <a class="pa-chip" href="{{ a | prepend: '/projects/' | append: '/' | relative_url }}">{{ areadef.name }}</a>
      {% endfor %}
    </div>
  {% endif %}

  {% if page.related_publications %}
    <h2>Publications</h2>
    <div class="publications">
      {% bibliography --cited_in_order %}
    </div>
  {% endif %}

  {% if site.giscus and page.giscus_comments %}
    {% include giscus.liquid %}
  {% endif %}
</div>
